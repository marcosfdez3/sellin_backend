DATABASE_URL=sqlite+aiosqlite:///./insider_track.db
EDGAR_USER_AGENT="Tu Nombre tu@email.com"
SYNC_INTERVAL_MINUTES=10
MIN_TRANSACTION_VALUE_USD=50000
CLUSTER_DAYS_WINDOW=7
CLUSTER_MIN_INSIDERS=2
DEBUG=true

# Clave para firmar los tokens de login. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Login con Google: ID de cliente OAuth de tipo "Aplicación web" (Google Cloud Console)
GOOGLE_CLIENT_ID=
