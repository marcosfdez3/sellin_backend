# Copia este archivo como .env y ajusta los valores

# En desarrollo usa SQLite (no necesitas instalar nada)
DATABASE_URL=sqlite+aiosqlite:///./insider_track.db

# En producción usa PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/insider_track

# IMPORTANTE: La SEC exige un User-Agent real con tu nombre y email
EDGAR_USER_AGENT="Tu Nombre tu@email.com"

# Cuántos minutos entre syncs (60 = cada hora)
SYNC_INTERVAL_MINUTES=60

# Valor mínimo en USD para considerar una transacción relevante
MIN_TRANSACTION_VALUE_USD=50000

# Ventana en días para detectar clusters de insiders
CLUSTER_DAYS_WINDOW=7
CLUSTER_MIN_INSIDERS=2

DEBUG=true
